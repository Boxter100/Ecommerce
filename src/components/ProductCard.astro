---
import { formatCents } from '../lib/format';
import type { Product } from '../lib/types';
import QuickAdd from './react/QuickAdd';

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
const image = product.images[0] ?? '';
const discount = product.original_price_cents
  ? Math.round((1 - product.price_cents / product.original_price_cents) * 100)
  : null;
---

<div
  class="card-hover animate-rise group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-white/40 dark:border-line-dark dark:bg-ink-2"
  style={`animation-delay: ${index * 70}ms`}
>
  <a href={`/producto/${product.slug}`} class="relative block aspect-square overflow-hidden bg-paper-2 dark:bg-ink-3" aria-label={product.name}>
    {
      image ? (
        <img src={image} alt={product.name} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" />
      ) : null
    }
    {discount !== null && (
      <span class="absolute left-3 top-3 rounded-full bg-ember px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white shadow-hard-sm">
        −{discount}%
      </span>
    )}
    <span class="absolute bottom-3 right-3 rounded-full bg-ink/75 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-paper backdrop-blur dark:bg-paper/85 dark:text-ink">
      {product.brand}
    </span>
  </a>

  <div class="flex flex-1 items-center justify-between gap-3 p-4">
    <div class="min-w-0">
      <a href={`/producto/${product.slug}`} class="block">
        <h3 class="truncate font-semibold leading-tight transition-colors group-hover:text-ember">{product.name}</h3>
      </a>
      <p class="mt-0.5 text-xs uppercase tracking-wider text-ink/50 dark:text-paper/50">
        {product.category?.name ?? 'Sin categoría'}
      </p>
    </div>
    <div class="shrink-0 text-right">
      <p class="font-display text-lg leading-none">{formatCents(product.price_cents)}</p>
      {
        product.original_price_cents && (
          <p class="mt-1 text-xs text-ink/40 line-through dark:text-paper/40">
            {formatCents(product.original_price_cents)}
          </p>
        )
      }
    </div>
  </div>

  <div class="px-4 pb-4">
    <QuickAdd client:visible product={product} />
  </div>
</div>