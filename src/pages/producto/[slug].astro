---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductPurchase from '../../components/react/ProductPurchase';
import { createSupabaseClient } from '../../lib/supabase/server';
import { isSupabaseConfigured } from '../../lib/env';
import { getProducts, getProductBySlug } from '../../lib/products';
import { formatCents } from '../../lib/format';
import type { Product } from '../../lib/types';

const supabase = isSupabaseConfigured()
  ? createSupabaseClient({ request: Astro.request, cookies: Astro.cookies })
  : null;

const slug = Astro.params.slug ?? '';
const product = await getProductBySlug(supabase, slug);

if (!product) {
  return Astro.redirect('/productos');
}

const related = product.category_id
  ? await getProducts(supabase, { limit: 4 }).then((all) => {
      const sameCategory = all.filter((p) => p.id !== product.id && p.category?.slug === product.category?.slug);
      return [...sameCategory, ...all.filter((p) => p.id !== product.id)].slice(0, 4);
    })
  : [];

const discount = product.original_price_cents
  ? Math.round((1 - product.price_cents / product.original_price_cents) * 100)
  : null;
const lowStock = product.stock > 0 && product.stock <= 5;

const image = product.images[0];
const productForIsland: Product = product;
---

<Layout title={`${product.name} · VUELTA`} description={product.description?.slice(0, 160) ?? product.name}>
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink/50 dark:text-paper/50" aria-label="Migas de pan">
      <a href="/productos" class="hover:text-ember">Productos</a>
      <span aria-hidden="true">/</span>
      <a href={`/productos?categoria=${product.category?.slug ?? ''}`} class="hover:text-ember">
        {product.category?.name ?? 'Todos'}
      </a>
      <span aria-hidden="true">/</span>
      <span class="truncate text-ink dark:text-paper">{product.name}</span>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-2">
      <div>
        <div class="card-hover relative overflow-hidden rounded-3xl border border-line bg-paper-2 dark:border-line-dark dark:bg-ink-2">
          {discount !== null && (
            <span class="absolute left-4 top-4 z-10 rounded-full bg-ember px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-white shadow-hard-sm">
              −{discount}%
            </span>
          )}
          {
            image ? (
              <img src={image} alt={product.name} class="aspect-square w-full object-cover" />
            ) : null
          }
        </div>
        {
          product.images.length > 1 && (
            <div class="mt-4 flex gap-3">
              {product.images.map((img) => (
                <img src={img} alt="" class="h-20 w-20 rounded-xl border border-line object-cover dark:border-line-dark" />
              ))}
            </div>
          )
        }
      </div>

      <div class="flex flex-col gap-6 lg:pt-4">
        <div class="flex flex-wrap items-center gap-2 text-xs font-bold uppercase tracking-[0.18em]">
          <span class="rounded-full bg-ink px-3 py-1 text-paper dark:bg-paper dark:text-ink">{product.brand}</span>
          <span class="rounded-full border border-line px-3 py-1 dark:border-line-dark">{product.category?.name}</span>
          {
            lowStock && (
              <span class="text-ember">¡Últimas unidades!</span>
            )
          }
        </div>

        <h1 class="font-display text-4xl uppercase leading-none sm:text-5xl">{product.name}</h1>

        <div class="flex items-baseline gap-3">
          <p class="font-display text-3xl">{formatCents(product.price_cents)}</p>
          {
            product.original_price_cents && (
              <p class="text-lg text-ink/40 line-through dark:text-paper/40">
                {formatCents(product.original_price_cents)}
              </p>
            )
          }
        </div>

        {
          product.description && (
            <p class="text-balance text-sm leading-relaxed text-ink/70 dark:text-paper/70">
              {product.description}
            </p>
          )
        }

        <div class="border-t border-line pt-6 dark:border-line-dark">
          <ProductPurchase client:load product={productForIsland} />
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
        <h2 class="font-display text-2xl uppercase">También te puede gustar</h2>
        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {related.map((p, i) => <ProductCard product={p} index={i} />)}
        </div>
      </section>
    )
  }
</Layout>