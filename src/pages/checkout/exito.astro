---
import Layout from '../../layouts/Layout.astro';

const sessionId = Astro.url.searchParams.get('session_id') ?? '';
const reference = sessionId ? sessionId.slice(0, 14).toUpperCase() : null;
---

<Layout title="¡Pago completado! · VUELTA" description="Gracias por tu compra en Vuelta.">
  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="animate-rise mx-auto max-w-xl text-center">
      <div class="mx-auto grid h-20 w-20 animate-pop place-items-center rounded-full bg-ember text-white shadow-hard">
        <svg class="h-10 w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5" />
        </svg>
      </div>
      <h1 class="font-display mt-8 text-4xl uppercase sm:text-5xl">¡Gracias por tu <span class="text-ember">compra</span>!</h1>
      <p class="mt-4 text-balance text-ink/70 dark:text-paper/70">
        Hemos recibido tu pedido correctamente. Te enviaremos un correo con el seguimiento del envío.
      </p>
      {reference && (
        <p class="mt-6 rounded-xl border border-line bg-paper-2/60 p-4 text-xs font-semibold uppercase tracking-wider text-ink/60 dark:border-line-dark dark:bg-ink-2 dark:text-paper/60">
          Referencia de pedido: {reference}
        </p>
      )}
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/productos" class="bg-ember px-5 py-3 font-bold uppercase tracking-widest text-white shadow-hard-sm transition-all hover:-translate-y-0.5">
          Seguir comprando
        </a>
        <a href="/" class="border-2 border-ink px-5 py-3 font-bold uppercase tracking-widest transition-all hover:bg-ink hover:text-paper dark:border-paper dark:hover:bg-paper dark:hover:text-ink">
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</Layout>